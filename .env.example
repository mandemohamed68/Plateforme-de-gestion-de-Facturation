# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# CONFIGURATION BASE DE DONNÉES LOCALE (MARIADB / MYSQL)
# ------------------------------------------------------------------------------
# Sur votre serveur local (ex: XAMPP, WAMP, MariaDB natif, Docker) :
# 1. Créez ou importez le script /docs/MARIADB_LABO_FULL_SCHEMA_SEEDS.sql
# 2. Vos données saisies dans l'application seront automatiquement
#    enregistrées dans vos tables SQL MariaDB (labo_echantillon, account_move, etc.)
# ------------------------------------------------------------------------------
DB_TYPE="mariadb"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="lab_facturation_db"
